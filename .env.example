# ---------------------------------------------------------------------------
# ALAES — Microsoft SQL Server connection
# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in your values, then restart the dev
# server. All MSSQL_* variables are read server-side only (never exposed to the
# browser). See System Admin -> Database Connection for a live connection test.
#
# IMPORTANT: a local SQL Server (localhost / LAN IP) is only reachable when the
# app itself runs on the same machine or network (`npm run dev` locally). The
# hosted v0 preview and Vercel deployments run in the cloud and cannot see your
# localhost — expose the server publicly (tunnel/VPN/Azure) for those.
# ---------------------------------------------------------------------------

# Hostname or IP of the SQL Server.
#   - Local default instance:  localhost
#   - LAN machine:             192.168.1.50
#   - Named instance:          MYPC\SQLEXPRESS  (also run the SQL Browser service)
MSSQL_SERVER=localhost

# TCP port SQL Server listens on. Default is 1433.
MSSQL_PORT=1433

# The database (catalog) to connect to.
MSSQL_DATABASE=ALAES

# SQL Server Authentication login. Enable "mixed mode" auth on the server;
# Windows-only authentication will not work with a user/password.
MSSQL_USER=sa
MSSQL_PASSWORD=your_password_here

# Encrypt the connection.
#   - false (default): typical for a local/on-prem dev server
#   - true:            REQUIRED for Azure SQL, or on-prem servers forcing TLS
MSSQL_ENCRYPT=false

# Accept self-signed certificates from internal servers. Leave true for local
# and most on-prem setups; set false only when using a trusted CA certificate.
MSSQL_TRUST_SERVER_CERTIFICATE=true
